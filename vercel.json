{
  "version": 2,
  "buildCommand": "echo 'No build step'",
  "devCommand": "echo 'No dev server'",
  "installCommand": "echo 'No install'",
  "framework": "none",
  "rewrites": [
    {
      "source": "/js/firebase-config.local.js",
      "destination": "/404.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ]
}